// Every way a certificate chain can fail to be one, a line each.
//
// This is where being wrong stops being a crash and starts being a stranger
// reading the traffic, so the discipline is the AEADs' and the RSA verifier's:
// one line per way of being wrong, because a single "a bad chain is refused"
// check passes with any one of these accepted.
//
// The list is not arbitrary. Each of these is a real historical failure: a
// certificate believed after it expired; a name checked loosely; an
// intermediate that never claimed to be a certificate authority and was used
// as one anyway, which is the 2008 flaw that let anybody with any certificate
// issue certificates for anybody; a `pathLenConstraint` ignored; a
// self-signed certificate treated as its own anchor; and an extension the
// issuer marked critical being skipped because the reader did not know it.
// expect: a good chain is still accepted
// expect: an expired certificate refused
// expect: a certificate not yet valid refused
// expect: a name that is not ours refused
// expect: a leaf that may not sign refused
// expect: an intermediate that is not a CA refused
// expect: a path length constraint enforced
// expect: a self-signed leaf refused
// expect: a chain to an unknown root refused
// expect: an unknown critical extension refused
// expect: a forged signature refused
// expect: a truncated certificate refused
// expect: no anchors at all refused
const x509 = @import("std/x509");
const bytes = @import("std/bytes");
const list = @import("std/list");
const array = @import("std/array");

const ROOT = "";
const ROOT2 = "";
const INTER = "";
const INTER_NOT_CA = "";
const INTER2 = "";
const LEAF = "";
const LEAF_EXPIRED = "";
const LEAF_FUTURE = "";
const LEAF_OTHER_NAME = "";
const LEAF_NO_SIGN = "";
const LEAF_DEEP = "";
const LEAF_SELF = "";
const LEAF_CRITICAL = "";

const NOW = 1700000000;

fn main() i64 {
    const roots = x509.parse_all([][]u8{ hex(ROOT) });
    const chain = [][]u8{ hex(INTER) };

    // Without this line every refusal below passes with a verifier that
    // refuses everything.
    x509.verify_chain(hex(LEAF), chain, roots, "localhost", NOW) catch return 1;
    print("a good chain is still accepted");

    refuse(LEAF_EXPIRED, chain, roots, "localhost", "an expired certificate refused");
    refuse(LEAF_FUTURE, chain, roots, "localhost", "a certificate not yet valid refused");
    refuse(LEAF_OTHER_NAME, chain, roots, "localhost", "a name that is not ours refused");
    refuse(LEAF_NO_SIGN, chain, roots, "localhost", "a leaf that may not sign refused");
    refuse(LEAF, [][]u8{ hex(INTER_NOT_CA) }, roots, "localhost",
           "an intermediate that is not a CA refused");
    refuse(LEAF_DEEP, [][]u8{ hex(INTER2), hex(INTER) }, roots, "localhost",
           "a path length constraint enforced");
    refuse(LEAF_SELF, chain, roots, "localhost", "a self-signed leaf refused");
    refuse(LEAF, chain, x509.parse_all([][]u8{ hex(ROOT2) }), "localhost",
           "a chain to an unknown root refused");
    refuse(LEAF_CRITICAL, chain, roots, "localhost",
           "an unknown critical extension refused");

    // The leaf's own signature, one bit different. Nothing about the names or
    // the dates changed, so this is the arithmetic refusing rather than a
    // check in front of it.
    const forged = hex(LEAF);
    forged[array.len(forged) - 1] ^= 1;
    x509.verify_chain(forged, chain, roots, "localhost", NOW) catch {
        print("a forged signature refused");
        return step(2);
    };
    return 2;
}

/// The rest of the cases, after the one that had to be written inline.
fn step(n: i64) i64 {
    const roots = x509.parse_all([][]u8{ hex(ROOT) });
    const chain = [][]u8{ hex(INTER) };
    const short = bytes.slice(hex(LEAF), 0, 40);
    x509.verify_chain(short, chain, roots, "localhost", NOW) catch {
        print("a truncated certificate refused");
        return last();
    };
    return n;
}

fn last() i64 {
    var empty: list.List[x509.Cert] = list.new();
    x509.verify_chain(hex(LEAF), [][]u8{ hex(INTER) }, empty, "localhost", NOW) catch {
        print("no anchors at all refused");
        return 0;
    };
    return 3;
}

fn refuse(leaf: str, chain: [][]u8, roots: list.List[x509.Cert], host: str,
          note: str) void {
    x509.verify_chain(hex(leaf), chain, roots, host, NOW) catch {
        print(note);
        return;
    };
    return;
}

fn hex(s: str) []u8 { return bytes.from_hex(s) catch bytes.new(0); }

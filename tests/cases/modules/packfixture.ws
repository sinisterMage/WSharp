// Two real git packfiles, and what is in them.
//
// Built by `git repack` over a repository with two commits, a subdirectory and
// a file that changes slightly -- which is what makes git write deltas at all.
// One uses offset deltas, which is what git writes by default; the other uses
// reference deltas, which is what `--no-delta-base-offset` writes and what an
// older server sends. Both paths have to work and only one of them is the
// common one, which is exactly why the uncommon one is here.
//
// `git verify-pack -v` says the first holds ten objects, eight of them whole,
// one delta at chain length 1 and one at chain length 2.

/// The packfile `git repack` wrote, with offset deltas.
pub fn offset_pack() str { return ""; }

/// The same objects with reference deltas instead.
pub fn reference_pack() str { return ""; }

/// The commit both packs are built from.
pub const HEAD = "63e2817089c3d11d6f227abe4ac80847cc195167";
/// The tree that commit names.
pub const TREE = "01b5de82eb64d75214be36ab6ff05481c999243c";

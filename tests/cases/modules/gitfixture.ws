// A whole conversation with a real `git upload-pack`, recorded.
//
// Not written by hand and not produced by this client: the requests below are
// the bytes `ingot/git` generates, and the answers are what
// `git upload-pack --stateless-rpc` said when it was given them --  which is
// exactly the program `git http-backend` puts behind the HTTP endpoint. So
// this checks two different things at once: that a real server *accepts* what
// this client sends, and that this client understands what a real server says.
//
// The advertisement is given twice because the two transports differ by a
// preamble: `git http-backend` prepends a `# service=` line and a flush that
// the bare command does not.

/// The `ls-refs` request this client writes.
pub fn ls_refs_request() str { return "30303134636f6d6d616e643d6c732d726566730a303031366167656e743d696e676f742f302e312e300a30303031303030397065656c0a303031627265662d70726566697820726566732f68656164732f0a303031617265662d70726566697820726566732f746167732f0a303031347265662d70726566697820484541440a30303030"; }
/// The `fetch` request this client writes.
pub fn fetch_request() str { return "30303132636f6d6d616e643d66657463680a303031366167656e743d696e676f742f302e312e300a30303031303031306e6f2d70726f67726573730a3030333277616e7420363365323831373038396333643131643666323237616265346163383038343763633139353136370a3030306464656570656e20310a30303039646f6e650a30303030"; }

/// The capability advertisement, as the bare command writes it.
pub fn advertisement() str { return "3030306576657273696f6e20320a303031626167656e743d6769742f322e35352e302d4c696e75780a303031336c732d726566733d756e626f726e0a3030323066657463683d7368616c6c6f7720776169742d666f722d646f6e650a303031327365727665722d6f7074696f6e0a303031376f626a6563742d666f726d61743d736861310a30303030"; }
/// The same as it arrives over HTTP, preamble included.
pub fn http_advertisement() str { return ""; }
/// What `ls-refs` answered.
pub fn refs() str { return "303033323633653238313730383963336431316436663232376162653461633830383437636331393531363720484541440a303033643633653238313730383963336431316436663232376162653461633830383437636331393531363720726566732f68656164732f6d61696e0a30303030"; }
/// What `fetch` answered: a shallow-info section and then the packfile.
pub fn fetched() str { return ""; }
/// What it answered when asked for a commit it does not have.
pub fn refusal() str { return "303034394552522075706c6f61642d7061636b3a206e6f74206f7572207265662030303030303030303030303030303030303030303030303030303030303030303030303030303031"; }

/// The commit the recorded fetch was for.
pub const HEAD = "63e2817089c3d11d6f227abe4ac80847cc195167";
